rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function canManageHr() {
      return request.auth != null
        && request.auth.token.role in ['admin', 'hr_manager'];
    }

    function validEmployee(data) {
      return data.keys().hasAll([
          'fullName', 'workEmail', 'department', 'jobTitle', 'employmentStatus',
          'phone', 'joiningDate', 'employmentType',
          'createdAt', 'updatedAt', 'createdBy', 'updatedBy'
        ])
        && data.keys().hasOnly([
          'fullName', 'workEmail', 'department', 'jobTitle', 'employmentStatus',
          'phone', 'joiningDate', 'employmentType', 'authUid',
          'createdAt', 'updatedAt', 'createdBy', 'updatedBy'
        ])
        && data.fullName is string && data.fullName.size() > 0 && data.fullName.size() <= 120
        && data.workEmail is string && data.workEmail.size() > 3 && data.workEmail.size() <= 254
        && data.phone is string && data.phone.size() <= 40
        && data.department is string && data.department.size() > 0 && data.department.size() <= 100
        && data.jobTitle is string && data.jobTitle.size() > 0 && data.jobTitle.size() <= 100
        && data.joiningDate is string && data.joiningDate.size() == 10
        && data.employmentType in ['Full-time', 'Part-time', 'Contract', 'Intern']
        && data.employmentStatus in ['Active', 'On leave', 'Inactive']
        && (!('authUid' in data) || (data.authUid is string && data.authUid.size() <= 128))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.createdBy is string
        && data.updatedBy is string;
    }

    function validEmailKey(data) {
      return data.keys().hasAll(['employeeId', 'createdAt', 'createdBy'])
        && data.keys().hasOnly(['employeeId', 'createdAt', 'createdBy'])
        && data.employeeId is string
        && data.createdAt is timestamp
        && data.createdBy is string;
    }

    function validDepartment(data) {
      return data.keys().hasAll([
          'name', 'nameLower', 'description', 'headEmployeeId',
          'createdAt', 'updatedAt', 'createdBy', 'updatedBy'
        ])
        && data.keys().hasOnly([
          'name', 'nameLower', 'description', 'headEmployeeId',
          'createdAt', 'updatedAt', 'createdBy', 'updatedBy'
        ])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.nameLower is string && data.nameLower == data.name.lower()
        && data.description is string && data.description.size() <= 500
        && data.headEmployeeId is string
        && data.createdAt is timestamp && data.updatedAt is timestamp
        && data.createdBy is string && data.updatedBy is string;
    }

    function validAttendance(data) {
      return data.keys().hasAll([
          'employeeId', 'employeeUid', 'employeeName', 'department', 'date', 'status',
          'checkInAt', 'checkOutAt', 'createdAt', 'updatedAt', 'createdBy', 'updatedBy'
        ])
        && data.keys().hasOnly([
          'employeeId', 'employeeUid', 'employeeName', 'department', 'date', 'status',
          'checkInAt', 'checkOutAt', 'createdAt', 'updatedAt', 'createdBy', 'updatedBy'
        ])
        && data.employeeId is string
        && (data.employeeUid == null || data.employeeUid is string)
        && data.employeeName is string
        && data.department is string
        && data.date is string && data.date.size() == 10
        && data.status in ['Present', 'Late', 'Absent', 'On Leave']
        && (data.checkInAt == null || data.checkInAt is timestamp)
        && (data.checkOutAt == null || data.checkOutAt is timestamp)
        && data.createdAt is timestamp && data.updatedAt is timestamp
        && data.createdBy is string && data.updatedBy is string;
    }

    function validLeave(data) {
      return data.keys().hasAll([
          'employeeUid', 'employeeEmail', 'leaveType', 'startDate', 'endDate', 'reason',
          'status', 'reviewerUid', 'reviewerComment', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'employeeUid', 'employeeEmail', 'leaveType', 'startDate', 'endDate', 'reason',
          'status', 'reviewerUid', 'reviewerComment', 'createdAt', 'updatedAt'
        ])
        && data.employeeUid is string
        && data.employeeEmail is string
        && data.leaveType in ['Casual', 'Sick', 'Annual']
        && data.startDate is string && data.startDate.size() == 10
        && data.endDate is string && data.endDate.size() == 10
        && data.reason is string && data.reason.size() > 0 && data.reason.size() <= 1000
        && data.status in ['Pending', 'Approved', 'Rejected']
        && (data.reviewerUid == null || data.reviewerUid is string)
        && data.reviewerComment is string && data.reviewerComment.size() <= 1000
        && data.createdAt is timestamp && data.updatedAt is timestamp;
    }

    match /employees/{employeeId} {
      allow get, list: if canManageHr()
        || (request.auth != null && resource.data.authUid == request.auth.uid);
      allow create: if canManageHr()
        && validEmployee(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedBy == request.auth.uid;
      allow update: if canManageHr()
        && validEmployee(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if canManageHr();
    }

    match /employeeEmailKeys/{emailKeyId} {
      allow get: if canManageHr();
      allow list: if false;
      allow create: if canManageHr()
        && validEmailKey(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if false;
      allow delete: if canManageHr();
    }

    match /departments/{departmentId} {
      allow get, list: if canManageHr();
      allow create: if canManageHr()
        && validDepartment(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedBy == request.auth.uid;
      allow update: if canManageHr()
        && validDepartment(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if canManageHr();
    }

    match /departmentNameKeys/{nameKeyId} {
      allow get: if canManageHr();
      allow list: if false;
      allow create: if canManageHr()
        && request.resource.data.keys().hasOnly(['departmentId', 'createdAt', 'createdBy'])
        && request.resource.data.departmentId is string
        && request.resource.data.createdAt == request.time
        && request.resource.data.createdBy == request.auth.uid;
      allow delete: if canManageHr();
      allow update: if false;
    }

    match /attendance/{attendanceId} {
      allow get, list: if canManageHr()
        || (request.auth != null
          && request.auth.token.role == 'employee'
          && resource.data.employeeUid == request.auth.uid);
      allow create: if canManageHr()
        && validAttendance(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedBy == request.auth.uid;
      allow update: if (canManageHr()
          && validAttendance(request.resource.data)
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.updatedAt == request.time
          && request.resource.data.updatedBy == request.auth.uid)
        || (request.auth != null
          && request.auth.token.role == 'employee'
          && resource.data.employeeUid == request.auth.uid
          && resource.data.checkInAt is timestamp
          && resource.data.checkOutAt == null
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'checkOutAt', 'updatedAt', 'updatedBy'
          ])
          && request.resource.data.checkOutAt == request.time
          && request.resource.data.updatedAt == request.time
          && request.resource.data.updatedBy == request.auth.uid);
      allow delete: if false;
    }

    match /leaveRequests/{requestId} {
      allow get, list: if canManageHr()
        || (request.auth != null
          && request.auth.token.role == 'employee'
          && resource.data.employeeUid == request.auth.uid);
      allow create: if request.auth != null
        && request.auth.token.role == 'employee'
        && validLeave(request.resource.data)
        && request.resource.data.employeeUid == request.auth.uid
        && request.resource.data.employeeEmail == request.auth.token.email
        && request.resource.data.status == 'Pending'
        && request.resource.data.reviewerUid == null
        && request.resource.data.reviewerComment == ''
        && request.resource.data.startDate <= request.resource.data.endDate
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if canManageHr()
        && validLeave(request.resource.data)
        && resource.data.status == 'Pending'
        && resource.data.employeeUid != request.auth.uid
        && request.resource.data.employeeUid == resource.data.employeeUid
        && request.resource.data.employeeEmail == resource.data.employeeEmail
        && request.resource.data.leaveType == resource.data.leaveType
        && request.resource.data.startDate == resource.data.startDate
        && request.resource.data.endDate == resource.data.endDate
        && request.resource.data.reason == resource.data.reason
        && request.resource.data.status in ['Approved', 'Rejected']
        && request.resource.data.reviewerUid == request.auth.uid
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'reviewerUid', 'reviewerComment', 'updatedAt'
        ]);
      allow delete: if false;
    }

    match /holidays/{holidayDate} {
      allow get, list: if request.auth != null
        && request.auth.token.role in ['admin', 'hr_manager', 'employee'];
      allow create: if canManageHr()
        && request.resource.data.keys().hasOnly([
          'name', 'date', 'description', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.date == holidayDate
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 500
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedBy == request.auth.uid;
      allow update: if canManageHr()
        && request.resource.data.keys().hasOnly([
          'name', 'date', 'description', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.date == holidayDate
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 500
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if canManageHr();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}